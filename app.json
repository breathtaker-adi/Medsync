{
  "expo": {
    "name": "MedSync",
    "slug": "medsync",
    "version": "1.2.0",
    "scheme": "medsync",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medsync.app",
      "infoPlist": {
        "NSCameraUsageDescription": "MedSync requires camera access to capture prescription photos for AI medication intake.",
        "NSPhotoLibraryUsageDescription": "MedSync requires photo library access to upload prescription images for verification."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.medsync.app",
      "allowBackup": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0D7377"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D7377"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0D7377"
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08976e05-387f-4b74-a4bb-f2a1fdc5540b"
      }
    },
    "owner": "breathtakeradis-team"
  }
}
